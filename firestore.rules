rules_version = '2';

// Modelo multi-tenant: toda coleção de nível raiz carrega `organizationId`,
// e o token de autenticação carrega as custom claims `orgId` e `role`
// (setadas pelo Admin SDK no login/convite). O fluxo público de assinatura
// (`sign/[token]`) nunca passa por aqui — usa o Admin SDK no servidor, que
// ignora estas regras; a validação de token/expiração é feita em código.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function tokenOrgId() {
      return request.auth.token.orgId;
    }

    function tokenRole() {
      return request.auth.token.role;
    }

    function belongsToOrg(orgId) {
      return isSignedIn() && tokenOrgId() == orgId;
    }

    function isOrgAdmin(orgId) {
      return belongsToOrg(orgId) && (tokenRole() == 'owner' || tokenRole() == 'admin');
    }

    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow update: if isOrgAdmin(orgId);
      // Criação de organização é orquestrada no servidor (Admin SDK) junto
      // com a definição das custom claims — nunca diretamente pelo cliente.
      allow create, delete: if false;

      match /members/{userId} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOrgAdmin(orgId);
      }
    }

    match /clients/{clientId} {
      allow read, update, delete: if belongsToOrg(resource.data.organizationId);
      allow create: if belongsToOrg(request.resource.data.organizationId);
    }

    match /templates/{templateId} {
      allow read, update, delete: if belongsToOrg(resource.data.organizationId);
      allow create: if belongsToOrg(request.resource.data.organizationId);
    }

    match /fieldDefinitions/{fieldId} {
      // organizationId == null: campo padrão do sistema, visível a todos os autenticados.
      allow read: if resource.data.organizationId == null || belongsToOrg(resource.data.organizationId);
      allow create: if belongsToOrg(request.resource.data.organizationId);
      allow update, delete: if belongsToOrg(resource.data.organizationId);
    }

    match /contracts/{contractId} {
      allow read, update: if belongsToOrg(resource.data.organizationId);
      allow create: if belongsToOrg(request.resource.data.organizationId);
      allow delete: if false;

      match /signatures/{signatureId} {
        allow read: if belongsToOrg(get(/databases/$(database)/documents/contracts/$(contractId)).data.organizationId);
        // Evidência de assinatura é gravada exclusivamente pelo servidor.
        allow write: if false;
      }

      match /auditLog/{eventId} {
        allow read: if belongsToOrg(get(/databases/$(database)/documents/contracts/$(contractId)).data.organizationId);
        allow write: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if belongsToOrg(resource.data.organizationId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
